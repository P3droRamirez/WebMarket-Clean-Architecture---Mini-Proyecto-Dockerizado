{
  "openapi": "3.0.1",
  "info": {
    "title": "Products API",
    "description": "Simple ASP.NET Core Web Api para Crud de productos",
    "contact": {
      "name": "Pedro Ramirez Gonzalez",
      "url": "https://github.com/P3droRamirez_",
      "email": "pedroramirez_1991@hotmail.com"
    },
    "license": {
      "name": "MIT License",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "v1"
  },
  "paths": {
    "/api/orders": {
      "post": {
        "tags": [
          "Order"
        ],
        "summary": "Crea una nueva orden de compra",
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderModel"
              },
              "example": {"productIds":[1,2,3]}
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderModel"
              },
              "example": {"productIds":[1,2,3]}
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/OrderModel"
              },
              "example": {"productIds":[1,2,3]}
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponseModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "409": {
            "description": "Conflict"
          },
          "500": {
            "description": "Server Error"
          }
        }
      },
      "get": {
        "tags": [
          "Order"
        ],
        "summary": "Obtiene todas las ordenes",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderResponseModel"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderResponseModel"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderResponseModel"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "tags": [
          "Order"
        ],
        "summary": "Obtiene una orden por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponseModel"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponseModel"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponseModel"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "tags": [
          "Product"
        ],
        "summary": "Obtiene todos los productos",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductResponseModel"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server Error"
          }
        }
      },
      "post": {
        "tags": [
          "Product"
        ],
        "summary": "Crea un nuevo Producto",
        "requestBody": {
          "description": "El ProductModel recibido como request",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductModel"
              },
              "example": {"name":"Play Station 5 pro 1tb","description":"La consola de videojuegos más potente del mercado","price":499.99,"stock":100}
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductModel"
              },
              "example": {"name":"Play Station 5 pro 1tb","description":"La consola de videojuegos más potente del mercado","price":499.99,"stock":100}
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ProductModel"
              },
              "example": {"name":"Play Station 5 pro 1tb","description":"La consola de videojuegos más potente del mercado","price":499.99,"stock":100}
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponseModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "409": {
            "description": "Conflict"
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
    "/api/products/{id}": {
      "get": {
        "tags": [
          "Product"
        ],
        "summary": "Busca un producto por su id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponseModel"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponseModel"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponseModel"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Product"
        ],
        "summary": "Elimina un Producto",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponseModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "409": {
            "description": "Conflict"
          },
          "500": {
            "description": "Server Error"
          }
        }
      },
      "put": {
        "tags": [
          "Product"
        ],
        "summary": "Actualiza un producto",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductModel"
              },
              "example": {"name":"Play Station 5 pro 1tb","description":"La consola de videojuegos más potente del mercado","price":499.99,"stock":100}
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductModel"
              },
              "example": {"name":"Play Station 5 pro 1tb","description":"La consola de videojuegos más potente del mercado","price":499.99,"stock":100}
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ProductModel"
              },
              "example": {"name":"Play Station 5 pro 1tb","description":"La consola de videojuegos más potente del mercado","price":499.99,"stock":100}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponseModel"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponseModel"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponseModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OkResponseModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "OrderModel": {
        "type": "object",
        "properties": {
          "productIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "OrderResponseModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "total": {
            "type": "number",
            "format": "double"
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductModel"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProductModel": {
        "required": [
          "description",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 50,
            "minLength": 2,
            "type": "string"
          },
          "description": {
            "maxLength": 200,
            "minLength": 10,
            "type": "string"
          },
          "price": {
            "minimum": 0,
            "exclusiveMinimum": true,
            "type": "number",
            "format": "double"
          },
          "stock": {
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "ProductResponseModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "stock": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    }
  }
}